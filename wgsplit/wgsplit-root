#!/usr/bin/env bash
# wgsplit-root — privileged half of wgsplit.
#
# Brings a WireGuard interface up without touching the default route, then
# installs nftables + policy routing so only sockets created inside the user's
# wgsplit.slice (systemd --user) leave through the tunnel:
#
#   socket cgroupv2 == wgsplit.slice  ->  fwmark 0x5157  ->  table 5157  ->  dev wgsplit
#
# DNS from that slice is redirected to a dnsmasq the user runs inside the same
# slice (wgsplit-dns.service), so lookups also leave through the tunnel.
#
# Installed to /usr/local/bin/wgsplit-root and allowed through sudoers for the
# desktop user only. Called by ~/.local/bin/wgsplit; not meant to be run by hand.
set -Eeuo pipefail

IFACE="wgsplit"
CONF="/etc/wireguard/${IFACE}.conf"
MARK="0x5157"
TABLE="5157"
PRIO="5157"
NFT_TABLE="wgsplit"
ALLOW_LAN="1"
DNS_PORT="5354"
DNS_FALLBACK="1.1.1.1 1.0.0.1"   # used when the WireGuard config has no DNS line; "" leaves DNS alone
RUN_DIR="/run/wgsplit"

# Optional overrides (IFACE, CONF, ALLOW_LAN, DNS_FALLBACK). Root-owned, so sudo can't be used to inject them.
if [[ -r /etc/wgsplit.env ]]; then
    # shellcheck disable=SC1091
    source /etc/wgsplit.env
fi

die() {
    echo "wgsplit-root: $*" >&2
    exit 1
}

require_root() {
    [[ $EUID -eq 0 ]] || die "must run as root (use: wgsplit up)"
}

target_uid() {
    local uid="${1:-}"
    [[ "$uid" =~ ^[0-9]+$ ]] || die "invalid uid '$uid'"
    if [[ -n "${SUDO_UID:-}" && "$uid" != "$SUDO_UID" ]]; then
        die "uid $uid does not match the calling user ($SUDO_UID)"
    fi
    echo "$uid"
}

slice_path() {
    echo "user.slice/user-$1.slice/user@$1.service/wgsplit.slice"
}

conf_values() {
    # Prints every value of an [Interface] key, one per line (comma lists split).
    awk -v key="$1" '
        /^[[:space:]]*\[/ { in_iface = ($0 ~ /^[[:space:]]*\[Interface\]/) ; next }
        in_iface {
            line = $0
            sub(/#.*/, "", line)
            if (match(line, "^[[:space:]]*" key "[[:space:]]*=")) {
                val = substr(line, RLENGTH + 1)
                n = split(val, parts, ",")
                for (i = 1; i <= n; i++) {
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", parts[i])
                    if (parts[i] != "") print parts[i]
                }
            }
        }
    ' IGNORECASE=1 "$CONF"
}

# DNS servers for the tunnel: the config's DNS addresses (search domains are
# skipped), or DNS_FALLBACK when there are none.
dns_servers() {
    local entry found=0
    while read -r entry; do
        if [[ "$entry" =~ ^[0-9.]+$ || "$entry" =~ ^[0-9a-fA-F:]+:[0-9a-fA-F:]*$ ]]; then
            echo "$entry"
            found=1
        fi
    done < <(conf_values DNS)
    if [[ $found -eq 0 ]]; then
        for entry in $DNS_FALLBACK; do
            echo "$entry"
        done
    fi
}

join_by() {
    local sep="$1" out="" item
    shift
    for item in "$@"; do
        out+="${out:+$sep}$item"
    done
    echo "$out"
}

del_rules() {
    local fam
    for fam in -4 -6; do
        while ip "$fam" rule del priority "$PRIO" 2>/dev/null; do :; done
        while ip "$fam" rule del priority "$((PRIO - 1))" 2>/dev/null; do :; done
        ip "$fam" route flush table "$TABLE" 2>/dev/null || true
    done
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    rm -f "$RUN_DIR/dns"
}

# nft rules that send the slice's port-53 traffic to the slice's own dnsmasq.
# Queries to the tunnel's DNS servers are left alone: that is dnsmasq itself.
dns_chain() {
    local slice="$1" v4=() v6=() server rules=""
    while read -r server; do
        [[ -z "$server" ]] && continue
        if [[ "$server" == *:* ]]; then v6+=("$server"); else v4+=("$server"); fi
    done < <(dns_servers)
    [[ ${#v4[@]} -eq 0 && ${#v6[@]} -eq 0 ]] && return 0

    local match="socket cgroupv2 level 4 \"$slice\" meta l4proto { tcp, udp } th dport 53"
    if [[ ${#v4[@]} -gt 0 ]]; then
        rules+="        $match ip daddr != { $(join_by ', ' "${v4[@]}") } redirect to :$DNS_PORT"$'\n'
    else
        rules+="        $match meta nfproto ipv4 redirect to :$DNS_PORT"$'\n'
    fi
    if [[ ${#v6[@]} -gt 0 ]]; then
        rules+="        $match ip6 daddr != { $(join_by ', ' "${v6[@]}") } redirect to :$DNS_PORT"$'\n'
    else
        rules+="        $match meta nfproto ipv6 redirect to :$DNS_PORT"$'\n'
    fi

    printf '    chain dns {\n        type nat hook output priority dstnat; policy accept;\n%s    }\n' "$rules"
}

# The whole nftables table for one user's slice. `print-rules` shows it without loading it.
ruleset() {
    local slice="$1"
    cat <<EOF
table inet $NFT_TABLE {
    chain output {
        type route hook output priority mangle; policy accept;
        socket cgroupv2 level 4 "$slice" meta mark set $MARK ct mark set meta mark
    }
    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;
        ct mark $MARK meta mark set ct mark
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "$IFACE" meta mark $MARK masquerade
    }
$(dns_chain "$slice")
}
EOF
}

add_rules() {
    local uid="$1" has_v6="$2" slice fam
    slice="$(slice_path "$uid")"
    [[ -d "/sys/fs/cgroup/$slice" ]] \
        || die "/sys/fs/cgroup/$slice is missing; start it with: systemctl --user start wgsplit-anchor.service"

    del_rules
    modprobe -q nft_socket 2>/dev/null || true

    # The unreachable fallback is the kill switch: with the interface gone, marked
    # traffic hits it instead of falling through to the main table.
    ip -4 route replace default dev "$IFACE" table "$TABLE"
    ip -4 route replace unreachable default metric 4096 table "$TABLE"
    if [[ "$has_v6" == 1 ]]; then
        ip -6 route replace default dev "$IFACE" table "$TABLE"
    fi
    ip -6 route replace unreachable default metric 4096 table "$TABLE"

    for fam in -4 -6; do
        if [[ "$ALLOW_LAN" == 1 ]]; then
            # Keep LAN/link routes from the main table, but never its default route.
            ip "$fam" rule add fwmark "$MARK" table main suppress_prefixlength 0 priority "$((PRIO - 1))"
        fi
        ip "$fam" rule add fwmark "$MARK" table "$TABLE" priority "$PRIO"
    done

    # cgroupv2 paths are resolved when the rule loads, so the slice must already
    # exist and stay alive (wgsplit-anchor.service keeps it).
    ruleset "$slice" | nft -f -

    # Tells `wgsplit up` which servers its dnsmasq should forward to.
    install -d -m 755 "$RUN_DIR"
    dns_servers > "$RUN_DIR/dns"
    chmod 644 "$RUN_DIR/dns"
}

iface_up() {
    [[ -f "$CONF" ]] || die "$CONF not found (copy your provider's WireGuard config there, mode 600)"

    ip link del "$IFACE" 2>/dev/null || true
    ip link add "$IFACE" type wireguard
    wg setconf "$IFACE" <(wg-quick strip "$CONF")

    local addr has_v6=0 mtu
    while read -r addr; do
        [[ -z "$addr" ]] && continue
        if [[ "$addr" == *:* ]]; then
            ip -6 address add "$addr" dev "$IFACE"
            has_v6=1
        else
            ip -4 address add "$addr" dev "$IFACE"
        fi
    done < <(conf_values Address)

    mtu="$(conf_values MTU | head -n1)"
    ip link set mtu "${mtu:-1420}" up dev "$IFACE"
    sysctl -q net.ipv4.conf.all.src_valid_mark=1
    echo "$has_v6"
}

cmd_up() {
    require_root
    local uid has_v6
    uid="$(target_uid "${1:-}")"
    has_v6="$(iface_up)"
    # Any failure from here on (set -E carries the trap into functions) undoes the half-built setup.
    trap 'echo "wgsplit-root: failed to install routing rules" >&2; ip link del "$IFACE" 2>/dev/null; del_rules' ERR
    add_rules "$uid" "$has_v6"
    trap - ERR
}

cmd_down() {
    require_root
    ip link del "$IFACE" 2>/dev/null || true
    if [[ "${1:-}" == "--keep-killswitch" ]]; then
        # Rules stay: tunneled apps now hit the unreachable route instead of leaking.
        return 0
    fi
    del_rules
}

cmd_stats() {
    require_root
    [[ -d "/sys/class/net/$IFACE" ]] || exit 3
    wg show "$IFACE" dump
}

case "${1:-}" in
    up) shift; cmd_up "$@" ;;
    down) shift; cmd_down "$@" ;;
    stats) cmd_stats ;;
    print-rules)
        # print-rules <uid> [wireguard.conf]: the ruleset `up` would load, for review and CI.
        uid="${2:-}"
        [[ "$uid" =~ ^[0-9]+$ ]] || die "usage: wgsplit-root print-rules <uid> [conf]"
        CONF="${3:-$CONF}"
        ruleset "$(slice_path "$uid")"
        ;;
    *) die "usage: wgsplit-root up <uid> | down [--keep-killswitch] | stats | print-rules <uid> [conf]" ;;
esac
